# Soyog AI backend env template for Azure Container Apps
# Use this as a reference when adding Environment Variables in Azure Container Apps.
# Do not commit real secrets.

# Core runtime
APP_ENV=production
BACKEND_URL=https://<your-container-app-fqdn>
FRONTEND_URL=https://research-hub-ai-lime.vercel.app
SECRET_KEY=<replace-with-strong-random-secret>

# AI provider
GROQ_API_KEY=<replace-with-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_LONGFORM_MODEL=llama-3.3-70b-versatile

# Auth cookies for cross-site HTTPS (Vercel frontend + Azure backend)
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=1
AUTH_COOKIE_DOMAIN=

# CORS behavior
ALLOW_VERCEL_PREVIEW_CORS=0
EXTRA_FRONTEND_URLS=

# Google OAuth (if enabled)
GOOGLE_CLIENT_ID=<replace-with-google-client-id>
GOOGLE_CLIENT_SECRET=<replace-with-google-client-secret>
GOOGLE_REDIRECT_URI=https://<your-container-app-fqdn>/auth/google/callback

# Firebase core
FIREBASE_PROJECT_ID=<replace-with-firebase-project-id>
FIREBASE_STORAGE_BUCKET=<your-project-id>.firebasestorage.app
FIREBASE_APPCHECK_ENFORCED=0
FIREBASE_APPCHECK_ALLOW_LOCALHOST=0

# --------------------------------------------------------------------
# Firebase service account credentials: choose ONE strategy only
# --------------------------------------------------------------------

# Strategy A (recommended): base64 encoded full JSON credentials
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=<base64-of-full-service-account-json>

# Strategy A.2 (alternative): raw JSON payload (single-line JSON string)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Strategy B (alternative): split fields
# FIREBASE_SERVICE_ACCOUNT_PROJECT_ID=<firebase-project-id>
# FIREBASE_SERVICE_ACCOUNT_CLIENT_EMAIL=<service-account-email>
# FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=<private-key-id>
# FIREBASE_SERVICE_ACCOUNT_CLIENT_ID=<client-id>
# FIREBASE_SERVICE_ACCOUNT_TOKEN_URI=https://oauth2.googleapis.com/token

# --------------------------------------------------------------------
# Optional hardening/observability
# --------------------------------------------------------------------

RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_PER_WINDOW=90
RATE_LIMIT_API_PER_WINDOW=300
RATE_LIMIT_STORE=memory
SECURITY_HEADERS_ENABLED=1
REQUIRE_EMAIL_VERIFICATION=1

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

OTEL_ENABLED=0
OTEL_SERVICE_NAME=researchhub-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=10
