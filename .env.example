# Example environment configuration for ResearchHub-AI
# Copy this file to `.env` (repo root for frontend envs if needed) and `backend/.env` for backend.
# IMPORTANT: Do not commit files containing real secrets.

# Backend application
APP_ENV=development  # values: development, production
SECRET_KEY=replace_with_a_strong_random_secret_key
USE_BCRYPT=1
BACKEND_URL=http://localhost:8010
FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_SAMESITE=lax
# Leave empty unless you need cross-subdomain cookies (e.g. .example.com)
AUTH_COOKIE_DOMAIN=
# 0 for local HTTP development, 1 for HTTPS-only production.
AUTH_COOKIE_SECURE=0
# For Vercel (https) -> Cloud Run (https) deploys, use:
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_SECURE=1
# Production CORS is strict by default (FRONTEND_URL + EXTRA_FRONTEND_URLS only).
# Set to 1 only if you intentionally want to allow Vercel preview origins.
ALLOW_VERCEL_PREVIEW_CORS=0
# Optional comma-separated extra exact origins for CORS (no wildcard).
EXTRA_FRONTEND_URLS=
# Set 0 in local development to allow immediate login after register.
# Set 1 in production to require email verification before login.
REQUIRE_EMAIL_VERIFICATION=0
# API hardening defaults (recommended for production)
RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_PER_WINDOW=90
RATE_LIMIT_API_PER_WINDOW=300
RATE_LIMIT_STORE=memory
# Required when RATE_LIMIT_STORE=redis
REDIS_URL=redis://localhost:6379/0
SECURITY_HEADERS_ENABLED=1
# Backend error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Backend distributed tracing (OpenTelemetry)
OTEL_ENABLED=0
OTEL_SERVICE_NAME=researchhub-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development
# If empty, traces are emitted to console exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=10
# Optional: protect /ops/metrics and /ops/slo with this header value.
# Requests must include: X-Metrics-Token: <value>
METRICS_AUTH_TOKEN=
# Only enable proxy header trust behind a reverse proxy you control.
TRUST_PROXY_HEADERS=0
# Comma-separated list of proxy IPs allowed to supply X-Forwarded-For.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Vector store provider: local | pgvector | pinecone | weaviate
VECTOR_STORE_PROVIDER=local
VECTOR_EMBEDDING_MODEL=all-MiniLM-L6-v2
# 0 keeps local hashing embeddings (fast/no download). Set to 1 for SentenceTransformers.
VECTOR_ENABLE_SENTENCE_TRANSFORMERS=0
# Pinecone
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_NAMESPACE_PREFIX=workspace
# Weaviate
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_CLASS=ResearchPaperVector
# Pgvector
PGVECTOR_TABLE=paper_embeddings_pgvector
# Firebase runtime backend (recommended for the fully migrated app)
# Set STORAGE_BACKEND=firebase and configure these values to run the full
# request-path persistence layer on Google services.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CREDENTIALS_PATH=C:/path/to/firebase-service-account.json
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# FIREBASE_APPCHECK_ENFORCED=0
# FIREBASE_APPCHECK_ALLOW_LOCALHOST=1
# Or set GOOGLE_APPLICATION_CREDENTIALS instead of FIREBASE_CREDENTIALS_PATH
# Optional: resolve env values from Google Secret Manager when the value starts with sm://...
# GOOGLE_CLOUD_SECRET_MANAGER_ENABLED=1
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOGGING_ENABLED=1

# Third-party API keys (placeholders only)
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_LONGFORM_MODEL=llama-3.3-70b-versatile
# Optional per-feature routing overrides
# GROQ_CHAT_MODEL=llama-3.1-8b-instant
# GROQ_UPLOAD_SUMMARY_MODEL=llama-3.3-70b-versatile
# GROQ_MINDMAP_MODEL=deepseek-r1-distill-llama-70b
# GROQ_PIPELINE_MODEL=deepseek-r1-distill-llama-70b
# Optional: comma-separated allowlist shown in Settings > AI Model Selection.
# GROQ_ALLOWED_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,deepseek-r1-distill-llama-70b
NASA_ADS_TOKEN=replace_with_nasa_ads_token
SEMANTIC_SCHOLAR_API_KEY=replace_with_semantic_scholar_api_key_optional
OPENALEX_MAILTO=replace_with_contact_email_optional
CROSSREF_MAILTO=replace_with_contact_email_optional
NCBI_API_KEY=replace_with_ncbi_api_key_optional
UNPAYWALL_MAILTO=replace_with_contact_email_optional

# Google OAuth
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
# Optional explicit callback URI (recommended if your backend port is not 8010)
# GOOGLE_REDIRECT_URI=http://localhost:8010/auth/google/callback

# Developer access (optional)
# Add one or more developer emails (comma-separated) to enable /developer APIs.
DEVELOPER_EMAILS=dev@example.com
# Optional header key for developer endpoints: send `X-Dev-Key: <value>`
DEV_ACCESS_KEY=replace_with_dev_access_key
# Only used in APP_ENV=development; set 1 to allow /developer access for any authenticated user.
ALLOW_DEV_PANEL=0

# Frontend envs (set in frontend/.env when needed)
VITE_API_URL=http://localhost:8010
# Global axios timeout (ms). Increase for long-running AI routes.
VITE_API_TIMEOUT_MS=120000
VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_messaging_sender_id
VITE_FIREBASE_APP_ID=replace_with_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_AUTH_ENABLED=1
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.0
VITE_FIREBASE_APPCHECK_PROVIDER=enterprise
VITE_FIREBASE_APPCHECK_SITE_KEY=replace_with_recaptcha_site_key
VITE_FIREBASE_MESSAGING_VAPID_KEY=replace_with_web_push_certificate_key_pair
SPRINGER_OPEN_ACCESS_KEY=replace_with_springer_open_access_key
SPRINGER_META_KEY=replace_with_springer_meta_key
