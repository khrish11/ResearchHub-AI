# Backend environment configuration for Soyog AI
# Copy this file to .env and fill in the actual values
# IMPORTANT: Do not commit files containing real secrets

# Backend application
APP_ENV=development  # values: development, production
SECRET_KEY=your_secret_key_here
USE_BCRYPT=1
# Set 0 in local development to allow immediate login after register.
# Set 1 in production to require email verification before login.
REQUIRE_EMAIL_VERIFICATION=0

# API hardening defaults (recommended for production)
RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_PER_WINDOW=90
RATE_LIMIT_API_PER_WINDOW=300
SECURITY_HEADERS_ENABLED=1

# Optional: protect /ops/metrics and /ops/slo with this header value.
# Requests must include: X-Metrics-Token: <value>
METRICS_AUTH_TOKEN=your_metrics_token_here

# Set to 1 when running behind nginx/load-balancer so real client IPs are used for rate limiting.
# Also set TRUSTED_PROXY_IPS to the IP(s) of your reverse proxy (e.g. 127.0.0.1,::1).
TRUST_PROXY_HEADERS=0
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Backend error tracking (Sentry)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Backend distributed tracing (OpenTelemetry)
OTEL_ENABLED=0
OTEL_SERVICE_NAME=researchhub-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development
# If empty, traces are emitted to console exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=10

# Firebase Configuration (REQUIRED)
STORAGE_BACKEND=firebase
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CREDENTIALS_PATH=/path/to/your/firebase-service-account.json
# Alternative: Use base64 encoded service account JSON
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=your_base64_encoded_json_here
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
FIREBASE_APPCHECK_ENFORCED=1
FIREBASE_APPCHECK_ALLOW_LOCALHOST=1
GOOGLE_CLOUD_PROJECT=your_firebase_project_id_here
GOOGLE_CLOUD_LOGGING_ENABLED=1
GOOGLE_CLOUD_SECRET_MANAGER_ENABLED=0

# AI Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Configuration
# Current production models: openai/gpt-oss-20b, openai/gpt-oss-120b, openai/gpt-oss-safeguard-20b, groq/compound, groq/compound-mini, qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-20b
GROQ_LONGFORM_MODEL=openai/gpt-oss-20b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_UPLOAD_SUMMARY_MODEL=openai/gpt-oss-20b
GROQ_MINDMAP_MODEL=openai/gpt-oss-20b
GROQ_PIPELINE_MODEL=openai/gpt-oss-20b

# Optional: Groq model allowlist shown in Settings
GROQ_ALLOWED_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,openai/gpt-oss-safeguard-20b,groq/compound,groq/compound-mini,qwen/qwen3.6-27b

# Third-party API Keys (optional)
NASA_ADS_TOKEN=your_nasa_ads_token_here
OPENALEX_MAILTO=your_email@example.com
NCBI_API_KEY=your_ncbi_api_key_here
UNPAYWALL_MAILTO=your_email@example.com
SPRINGER_OPEN_ACCESS_KEY=your_springer_oa_key_here
SPRINGER_META_KEY=your_springer_meta_key_here

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8010/auth/google/callback

# Developer access (optional)
# Add one or more developer emails (comma-separated) to enable /developer APIs.
DEVELOPER_EMAILS=your_email@example.com
# Optional header key for developer endpoints: send `X-Dev-Key: <value>`
DEV_ACCESS_KEY=your_dev_key_here
# Only used in APP_ENV=development; set 1 to allow /developer access for any authenticated user.
ALLOW_DEV_PANEL=0

# Email Configuration (optional)
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_mail_password_here
MAIL_FROM=your_email@example.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=1
MAIL_SSL_TLS=0

# Vector Store Configuration
# Production: FirestoreVectorStore (requires Firestore db)
# Development: InMemoryVectorStore (if db not provided)
VECTOR_EMBEDDING_MODEL=all-MiniLM-L6-v2
# 0 keeps local hashing embeddings (fast/no download). Set to 1 for SentenceTransformers.
VECTOR_ENABLE_SENTENCE_TRANSFORMERS=0

# Backend URLs
BACKEND_URL=http://localhost:8010
FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=0
