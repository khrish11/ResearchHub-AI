#!/usr/bin/env sh
set -eu

# Block direct pushes to protected branches on this machine.
# Emergency override: ALLOW_PROTECTED_PUSH=1 git push ...
if [ "${ALLOW_PROTECTED_PUSH:-0}" != "1" ]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
      refs/heads/main|refs/heads/master)
        if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
          branch_name="${remote_ref#refs/heads/}"
          echo "Push blocked: direct pushes to $branch_name are disabled."
          echo "Use a feature branch and open a pull request."
          echo "Emergency only: ALLOW_PROTECTED_PUSH=1 git push ..."
          exit 1
        fi
        ;;
    esac
  done
fi

# Block obvious leaked credential patterns before push.
PATTERN='ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|gho_[A-Za-z0-9]{20,}|ghu_[A-Za-z0-9]{20,}|glpat-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z\-_]{35}'

staged_files="$(git diff --cached --name-only | grep -v "^.githooks/pre-push$" || true)"
if [ -n "$staged_files" ]; then
  if printf "%s\n" "$staged_files" | xargs grep -nE "$PATTERN" >/dev/null 2>&1; then
    echo "Push blocked: possible secret/token detected in staged files."
    echo "Remove the secret, rotate if exposed, and try again."
    exit 1
  fi
fi

if git grep -nE "$PATTERN" -- . ":(exclude).githooks/pre-push" >/dev/null 2>&1; then
  echo "Push blocked: possible secret/token pattern exists in working tree."
  echo "Remove the secret before pushing."
  exit 1
fi

exit 0
